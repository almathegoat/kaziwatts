<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Windows uniquement : aucun SDK Android / iOS requis.
             Le TFM suit la version du SDK .NET installé (8, 9 ou 10). -->
        <TargetFramework>net$(NETCoreSdkVersion.Split('.')[0]).0-windows10.0.19041.0</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>KaziWatts</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <ApplicationTitle>KaziWatts</ApplicationTitle>
        <ApplicationId>com.kaziwatts.app</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

        <!-- Application non packagée : pas de certificat MSIX, pas de mode développeur -->
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#050B1E" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2557FF" BaseSize="128,128" />
        
        <!-- AJOUTÉ ICI : Référence explicite exigée par le SDK MAUI 10 -->
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    </ItemGroup>

    <ItemGroup>
        <!-- Polices Inter et images des maquettes (Remove puis Include : évite tout doublon avec les éléments par défaut) -->
        <MauiFont Remove="Resources\Fonts\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiImage Remove="Resources\Images\*" />
        <MauiImage Include="Resources\Images\*" />
    </ItemGroup>

</Project>