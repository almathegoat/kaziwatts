<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:KaziWatts.Controls"
             x:Class="KaziWatts.Views.MeterReadingPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <ctl:PageHeader Title="Relevé compteur" Subtitle="Une lecture précise, une répartition juste." Margin="0,4,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0,24,16" Spacing="0">

                <!-- Carte compteur -->
                <Border HeightRequest="76" Margin="0,20.5,0,0" Padding="17" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}">
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                            <ctl:Icon Name="gauge" Size="22" Thickness="1.5" Color="{StaticResource Success}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label x:Name="MeterNumber" Text="" FontFamily="InterSemiBold" FontSize="13" />
                            <Label x:Name="MeterKind" Text="Compteur principal" Style="{StaticResource Muted}" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Connecté" FontFamily="InterSemiBold" FontSize="12.5"
                               TextColor="{StaticResource Success}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Dernier relevé enregistré -->
                <Border HeightRequest="128" Margin="0,16,0,0" Padding="0" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}">
                    <AbsoluteLayout>
                        <Label Text="Dernier relevé enregistré" Style="{StaticResource Muted}" FontSize="12"
                               AbsoluteLayout.LayoutBounds="17,17,AutoSize,AutoSize" />
                        <Label x:Name="LastIndexLabel" Text="–" FontFamily="InterBold" FontSize="39" AbsoluteLayout.LayoutBounds="16,38.8,AutoSize,AutoSize" />
                        <Label Text="kWh" Style="{StaticResource Muted}" FontSize="14" AbsoluteLayout.LayoutBounds="154,63,AutoSize,AutoSize" />
                        <Label x:Name="LastDateLabel" Text="" Style="{StaticResource Muted}" FontSize="11"
                               AbsoluteLayout.LayoutBounds="17,96.3,AutoSize,AutoSize" />
                    </AbsoluteLayout>
                </Border>

                <Label Text="Nouvel index relevé" FontFamily="InterSemiBold" FontSize="12" Margin="0,16,0,0" />
                <ctl:TextField x:Name="IndexField" Placeholder="1 258,4" IconName="scan-line" KeyboardType="Numeric"
                               Margin="0,7.5,0,0" TextChanged="OnIndexChanged" />

                <ctl:InfoBanner x:Name="DeltaInfo" IconName="trending-up" Margin="0,16,0,0"
                                Text="+9,8 kWh depuis le dernier relevé · ≈ 1 470 FCFA" />

                <Label x:Name="ErrorLabel" IsVisible="False" FontSize="12" Margin="0,10,0,0" TextColor="{StaticResource Danger}" />

                <ctl:ArrowButton Text="Enregistrer le relevé" IconName="check" Margin="0,16,0,0" Clicked="OnSave" />

                <Label Text="Historique des relevés" FontFamily="InterSemiBold" FontSize="13" Margin="0,17,0,0" />

                <Border x:Name="HistoryCard" Margin="0,15,0,0" Padding="0" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}">
                    <VerticalStackLayout x:Name="History" VerticalOptions="Center" Padding="17,8" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="30">
                                    <Label Text="{Binding Line}" FontFamily="InterSemiBold" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding IndexText}" FontFamily="InterRegular" FontSize="12.7" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ctl:BottomNav Grid.Row="2" Active="home" />
    </Grid>
</ContentPage>
