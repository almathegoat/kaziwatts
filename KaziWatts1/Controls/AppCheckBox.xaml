<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:KaziWatts.Controls"
             x:Class="KaziWatts.Controls.AppCheckBox">
    <!-- Case 14 x 14, rayon 4, contour bleu 1,2, coche bleue -->
    <Border WidthRequest="14.5" HeightRequest="14.5" Padding="0" StrokeThickness="1.2"
            StrokeShape="RoundRectangle 4"
            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
            BackgroundColor="Transparent" VerticalOptions="Center">
        <ctl:Icon x:Name="Tick" Name="check" Size="11" Thickness="2.2"
                  Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource LinkDark}}" />
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
