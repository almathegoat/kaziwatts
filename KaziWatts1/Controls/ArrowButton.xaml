<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:KaziWatts.Controls"
             x:Class="KaziWatts.Controls.ArrowButton">
    <!-- Bouton principal des maquettes : hauteur 54, rayon 16, texte Inter SemiBold 14 + icône à droite -->
    <Border x:Name="Root" HeightRequest="54" Padding="0"
            BackgroundColor="{StaticResource Primary}" Stroke="Transparent"
            StrokeShape="RoundRectangle 14">
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <Label x:Name="TextLabel" FontFamily="InterSemiBold" FontSize="14"
                   TextColor="White" VerticalOptions="Center" />
            <ctl:Icon x:Name="Glyph" Name="arrow-right" Size="20" Color="White" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
