<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:KaziWatts.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="KaziWatts.Controls.PageHeader">
    <!-- En-tête : flèche retour (24), titre Inter Bold 21,7, menu « ··· » ; sous-titre optionnel (Inter 11,9) -->
    <VerticalStackLayout Spacing="0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="23,0,27,0" HeightRequest="44">
            <ctl:Icon x:Name="Back" Name="arrow-left" Size="24" Thickness="1.5" VerticalOptions="Center"
                      Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}">
                <ctl:Icon.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </ctl:Icon.GestureRecognizers>
            </ctl:Icon>

            <Label x:Name="TitleLabel" Grid.Column="1" FontFamily="InterBold" FontSize="21.7"
                   VerticalOptions="Center" LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

            <HorizontalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                <shapes:Ellipse WidthRequest="3.3" HeightRequest="3.3"
                                Fill="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <shapes:Ellipse WidthRequest="3.3" HeightRequest="3.3"
                                Fill="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <shapes:Ellipse WidthRequest="3.3" HeightRequest="3.3"
                                Fill="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </HorizontalStackLayout>
        </Grid>

        <Label x:Name="SubtitleLabel" IsVisible="False" Style="{StaticResource Muted}" FontSize="11.9"
               Margin="24,-3,24,0" />
    </VerticalStackLayout>
</ContentView>
